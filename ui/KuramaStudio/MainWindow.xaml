<Window x:Class="KuramaStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:KuramaStudio.ViewModels"
        xmlns:conv="clr-namespace:KuramaStudio.Converters"
        Title="Kurama Studio"
        Width="1280" Height="820"
        MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrushBgDeep}"
        FontFamily="{StaticResource UiFont}">
  <Window.Resources>
    <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
    <conv:InverseBoolConverter x:Key="InverseBool"/>
  </Window.Resources>
  <Window.DataContext>
    <vm:MainViewModel/>
  </Window.DataContext>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="232"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- Sidebar -->
    <Border Grid.Column="0" Background="{StaticResource BrushBgPanel}" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="0,0,1,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="18,22,18,10">
          <TextBlock Text="✦ KURAMA" FontSize="20" FontWeight="Bold" Foreground="{StaticResource BrushAccent}"/>
          <TextBlock Text="local agent studio" Foreground="{StaticResource BrushTextMuted}" FontSize="11.5" Margin="0,2,0,0"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Margin="12,0,12,16">
          <Border Style="{StaticResource CardStyle}" Padding="12" Margin="0,0,0,10">
            <StackPanel>
              <TextBlock Text="Backend: llama.cpp" Foreground="{StaticResource BrushTextMuted}" FontSize="11"/>
              <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource BrushTextPrimary}" FontWeight="SemiBold" Margin="0,2,0,0"/>
              <TextBlock Text="{Binding ConnectionDetail}" Foreground="{StaticResource BrushTextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
              <TextBlock Text="http://127.0.0.1:8080/v1" Foreground="{StaticResource BrushTextMuted}" FontSize="10" Margin="0,4,0,0"/>
            </StackPanel>
          </Border>
          <Button Content="Refresh / reconnect" Style="{StaticResource GhostButton}"
                  Command="{Binding RefreshConnectionCommand}" HorizontalAlignment="Stretch"
                  ToolTip="Probe llama-server and start it if needed (not Ollama)"/>
        </StackPanel>

        <StackPanel Margin="4,8,4,0">
          <RadioButton Content="Chat" Tag="💬" Style="{StaticResource NavButtonStyle}" IsChecked="True"
                       Command="{Binding NavigateCommand}" CommandParameter="Chat"/>
          <RadioButton Content="Models &amp; Load" Tag="🧠" Style="{StaticResource NavButtonStyle}"
                       Command="{Binding NavigateCommand}" CommandParameter="Models"/>
          <RadioButton Content="Resources" Tag="⚙" Style="{StaticResource NavButtonStyle}"
                       Command="{Binding NavigateCommand}" CommandParameter="Resources"/>
          <RadioButton Content="Agent Settings" Tag="🎛" Style="{StaticResource NavButtonStyle}"
                       Command="{Binding NavigateCommand}" CommandParameter="Settings"/>
          <RadioButton Content="Appearance" Tag="✨" Style="{StaticResource NavButtonStyle}"
                       Command="{Binding NavigateCommand}" CommandParameter="Appearance"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Main -->
    <Grid Grid.Column="1" Margin="22">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <DockPanel Grid.Row="0" Margin="0,0,0,16">
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
          <Button Content="★ Reward last run" Style="{StaticResource PrimaryButton}"
                  Command="{Binding RewardLastRunCommand}" Margin="0,0,8,0"
                  ToolTip="Reinforce the last run: boost beliefs and save lessons (separate from chat)"/>
          <Button Content="Clear chat" Style="{StaticResource GhostButton}" Command="{Binding ClearChatCommand}"
                  Margin="0,0,8,0" ToolTip="Wipe persisted chat history on this machine"/>
          <Button Content="Save config" Style="{StaticResource GhostButton}" Command="{Binding SaveConfigCommand}"/>
        </StackPanel>
        <TextBlock FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Text" Value="Chat"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedPage}" Value="Models"><Setter Property="Text" Value="Models &amp; Load"/></DataTrigger>
                <DataTrigger Binding="{Binding SelectedPage}" Value="Resources"><Setter Property="Text" Value="Resource Allocation"/></DataTrigger>
                <DataTrigger Binding="{Binding SelectedPage}" Value="Settings"><Setter Property="Text" Value="Agent Settings"/></DataTrigger>
                <DataTrigger Binding="{Binding SelectedPage}" Value="Appearance"><Setter Property="Text" Value="Appearance"/></DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
      </DockPanel>

      <!-- CHAT -->
      <Grid Grid.Row="1">
        <Grid.Style>
          <Style TargetType="Grid">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
              <DataTrigger Binding="{Binding SelectedPage}" Value="Chat"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
            </Style.Triggers>
          </Style>
        </Grid.Style>
        <Grid.RowDefinitions>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="160"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,12" Padding="10">
          <Grid>
            <ScrollViewer x:Name="ChatScroll"
                          VerticalScrollBarVisibility="Auto"
                          ScrollChanged="ChatScroll_ScrollChanged">
              <ItemsControl x:Name="ChatItems" ItemsSource="{Binding Bubbles}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Margin="0,0,0,10" Padding="12" CornerRadius="12"
                            Background="{StaticResource BrushBgInput}" HorizontalAlignment="Stretch">
                      <StackPanel>
                        <TextBlock Text="{Binding Who}" Foreground="{StaticResource BrushAccent}" FontSize="11" FontWeight="SemiBold"/>
                        <Border Margin="0,8,0,6" Padding="10,8" CornerRadius="8"
                                Background="#221A1208" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1"
                                Visibility="{Binding HasThinking, Converter={StaticResource BoolToVis}}">
                          <StackPanel>
                            <DockPanel>
                              <TextBlock DockPanel.Dock="Left" FontWeight="SemiBold" FontSize="12"
                                         Foreground="{StaticResource BrushAccent}">
                                <TextBlock.Style>
                                  <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{Binding ThinkingLabel}"/>
                                    <Style.Triggers>
                                      <DataTrigger Binding="{Binding IsThinking}" Value="True">
                                        <Setter Property="Text" Value="Thinking…"/>
                                      </DataTrigger>
                                    </Style.Triggers>
                                  </Style>
                                </TextBlock.Style>
                              </TextBlock>
                              <ToggleButton DockPanel.Dock="Right" Content="▾" Width="28" Height="22"
                                            IsChecked="{Binding ThinkingExpanded}" Background="Transparent"
                                            Foreground="{StaticResource BrushTextMuted}" BorderThickness="0" Cursor="Hand"/>
                            </DockPanel>
                            <TextBox Margin="0,6,0,0" Text="{Binding Thinking, Mode=OneWay}"
                                     IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0"
                                     Background="Transparent" Foreground="{StaticResource BrushTextSecondary}"
                                     FontFamily="{StaticResource MonoFont}" FontSize="11.5"
                                     VerticalScrollBarVisibility="Auto" MaxHeight="180"
                                     Visibility="{Binding ThinkingExpanded, Converter={StaticResource BoolToVis}}"/>
                          </StackPanel>
                        </Border>
                        <TextBox Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                 BorderThickness="0" Background="Transparent"
                                 Foreground="{StaticResource BrushTextPrimary}"
                                 FontFamily="{StaticResource UiFont}" FontSize="13.5"
                                 Margin="0,4,0,0"/>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
            <Button x:Name="ScrollToBottomBtn"
                    Content="↓ New messages"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Margin="0,0,12,12" Padding="12,6"
                    Style="{StaticResource GhostButton}"
                    Click="ScrollToBottom_Click"
                    Visibility="Collapsed"/>
          </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="12" Margin="0,0,0,12">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBox x:Name="ComposerBox"
                     Grid.Row="0" Grid.Column="0" Style="{StaticResource KuramaTextBox}"
                     Text="{Binding GoalText, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True" MinHeight="56" MaxHeight="140" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     PreviewKeyDown="Composer_PreviewKeyDown"
                     Tag="Ask anything"/>
            <StackPanel Grid.Row="0" Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Bottom">
              <Button x:Name="SendBtn" Content="Send" Style="{StaticResource PrimaryButton}"
                      Command="{Binding RunAgentCommand}"
                      Width="110" Margin="0,0,0,8" Click="Send_Click"/>
              <Button Content="Stop" Style="{StaticResource GhostButton}"
                      Command="{Binding StopAgentCommand}" Width="110"/>
            </StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="0,10,0,0">
              <CheckBox Content="Agent mode (tools)" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding AgentMode}"
                        Width="260" Margin="0,0,14,0" Tag="Off = streamed chat · On = tool-using agent loop"/>
              <CheckBox Content="Dry run" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding DryRun}" Width="180" Margin="0,0,14,0"
                        Tag="Skip the LLM; deterministic policy"/>
              <TextBlock Text="Max steps" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <TextBox Width="56" Style="{StaticResource KuramaTextBox}" Text="{Binding RunMaxSteps}" Padding="8,6"/>
              <TextBlock Text="{Binding SelectedChatModel, StringFormat=Model: {0}}" Foreground="{StaticResource BrushTextMuted}"
                         VerticalAlignment="Center" Margin="14,0,0,0"/>
            </StackPanel>
          </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="10">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="Live log" Style="{StaticResource FieldLabel}"/>
            <ListBox ItemsSource="{Binding LogLines}" Background="Transparent" BorderThickness="0"
                     Foreground="{StaticResource BrushTextSecondary}" FontFamily="{StaticResource MonoFont}" FontSize="11.5"/>
          </DockPanel>
        </Border>
      </Grid>

      <!-- MODELS -->
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <ScrollViewer.Style>
          <Style TargetType="ScrollViewer">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
              <DataTrigger Binding="{Binding SelectedPage}" Value="Models"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
            </Style.Triggers>
          </Style>
        </ScrollViewer.Style>
        <StackPanel>
          <TextBlock Style="{StaticResource SectionHint}" Text="Pick a GGUF from disk. Browse opens File Explorer. Load restarts llama-server with that file (this is not an Ollama tag list)."/>
          <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
            <StackPanel>
              <TextBlock Text="GGUF file" Style="{StaticResource FieldLabel}"/>
              <DockPanel Margin="0,0,0,10">
                <Button DockPanel.Dock="Right" Content="Browse…" Style="{StaticResource PrimaryButton}"
                        Command="{Binding BrowseGgufCommand}" Margin="8,0,0,0" MinWidth="110"
                        ToolTip="Open File Explorer and choose a .gguf"/>
                <TextBox Style="{StaticResource KuramaTextBox}"
                         Text="{Binding SelectedModelPath, UpdateSourceTrigger=PropertyChanged}"
                         FontFamily="{StaticResource MonoFont}"
                         ToolTip="Path to the GGUF llama-server should load"/>
              </DockPanel>
              <StackPanel Orientation="Horizontal">
                <Button Content="Load this GGUF" Style="{StaticResource PrimaryButton}"
                        Command="{Binding LoadSelectedGgufCommand}" Margin="0,0,8,0"
                        IsEnabled="{Binding IsLoadingModel, Converter={StaticResource InverseBool}}"
                        ToolTip="Stop llama-server (even if Studio did not start it) then load this file"/>
                <Button Content="Stop server" Style="{StaticResource GhostButton}"
                        Command="{Binding StopServerCommand}" Margin="0,0,8,0"
                        ToolTip="Kill llama-server on this port so a new GGUF can bind"/>
                <Button Content="Scan models folder" Style="{StaticResource GhostButton}"
                        Command="{Binding ScanGgufFolderCommand}" Margin="0,0,8,0"/>
                <Button Content="Refresh server" Style="{StaticResource GhostButton}"
                        Command="{Binding RefreshConnectionCommand}"/>
              </StackPanel>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
            <StackPanel>
              <TextBlock Text="GGUFs on disk" Style="{StaticResource FieldLabel}"/>
              <TextBlock Style="{StaticResource SectionHint}" Text="Click a row to select it, then Load. Double-click also loads."/>
              <ListBox ItemsSource="{Binding AvailableGgufs}"
                       SelectedItem="{Binding SelectedGguf}"
                       MinHeight="88" MaxHeight="220" Margin="0,6,0,0"
                       Background="{StaticResource BrushBgInput}"
                       BorderBrush="{StaticResource BrushBorderSubtle}"
                       Foreground="{StaticResource BrushTextPrimary}"
                       ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.InputBindings>
                  <MouseBinding Gesture="LeftDoubleClick" Command="{Binding LoadSelectedGgufCommand}"/>
                </ListBox.InputBindings>
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <DockPanel Margin="2,4">
                      <TextBlock DockPanel.Dock="Right" Text="{Binding SizeLabel}"
                                 Foreground="{StaticResource BrushTextMuted}" FontSize="11"
                                 VerticalAlignment="Center" Margin="12,0,0,0"/>
                      <StackPanel>
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Folder}" Foreground="{StaticResource BrushTextMuted}"
                                   FontSize="11" FontFamily="{StaticResource MonoFont}" TextTrimming="CharacterEllipsis"/>
                      </StackPanel>
                    </DockPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <TextBlock Text="Currently loaded by llama-server" Style="{StaticResource FieldLabel}" Margin="0,16,0,6"/>
              <ItemsControl ItemsSource="{Binding LoadedModels}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding}" Foreground="{StaticResource BrushSuccess}" FontFamily="{StaticResource MonoFont}" Margin="0,2"/>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource CardStyle}">
            <StackPanel>
              <TextBlock Style="{StaticResource SectionTitle}" Text="Load presets"/>
              <TextBlock Style="{StaticResource SectionHint}" Text="Presets write context, batch, GPU layers, keep-alive, and timeouts for optimal runs."/>
              <WrapPanel>
                <Button Content="CPU Optimal" Style="{StaticResource GhostButton}" Margin="0,0,8,8" Command="{Binding ApplyPresetCommand}" CommandParameter="cpu_optimal"/>
                <Button Content="Balanced" Style="{StaticResource GhostButton}" Margin="0,0,8,8" Command="{Binding ApplyPresetCommand}" CommandParameter="balanced"/>
                <Button Content="Max Context" Style="{StaticResource GhostButton}" Margin="0,0,8,8" Command="{Binding ApplyPresetCommand}" CommandParameter="max_context"/>
                <Button Content="Fast Draft" Style="{StaticResource GhostButton}" Margin="0,0,8,8" Command="{Binding ApplyPresetCommand}" CommandParameter="fast_draft"/>
                <Button Content="Auto (this PC)" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8" Command="{Binding AutoAllocateResourcesCommand}"/>
              </WrapPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <!-- RESOURCES -->
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <ScrollViewer.Style>
          <Style TargetType="ScrollViewer">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
              <DataTrigger Binding="{Binding SelectedPage}" Value="Resources"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
            </Style.Triggers>
          </Style>
        </ScrollViewer.Style>
        <StackPanel>
          <TextBlock Style="{StaticResource SectionHint}" Text="Good resource allocation keeps 1B models responsive on small laptops: modest context, CPU threads with headroom, short keep-alive, warmup before the first real call."/>
          <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
            <StackPanel>
              <CheckBox Content="Warm up model before runs" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Warmup}"
                        Tag="Loads weights with the same options the run will use" Margin="0,0,0,12"/>
              <CheckBox Content="Dry-run if server unreachable" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding DryRunOnNoServer}"
                        Tag="Fall back to deterministic policy when Ollama is down" Margin="0,0,0,12"/>

              <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,14">
                  <TextBlock Text="{Binding NumCtx, StringFormat=Context window (num_ctx): {0}}" Style="{StaticResource FieldLabel}"/>
                  <Slider Minimum="4096" Maximum="65536" TickFrequency="2048" IsSnapToTickEnabled="True" Value="{Binding NumCtx}" Style="{StaticResource KuramaSlider}"/>
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="1" Margin="12,0,0,14">
                  <TextBlock Text="{Binding NumBatch, StringFormat=Batch (num_batch): {0}}" Style="{StaticResource FieldLabel}"/>
                  <Slider Minimum="32" Maximum="1024" TickFrequency="32" IsSnapToTickEnabled="True" Value="{Binding NumBatch}" Style="{StaticResource KuramaSlider}"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,12,14">
                  <TextBlock Text="{Binding NumGpu, StringFormat='GPU layers: {0}'}" Style="{StaticResource FieldLabel}"/>
                  <Slider Minimum="-1" Maximum="99" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding NumGpu}" Style="{StaticResource KuramaSlider}"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Margin="12,0,0,14">
                  <TextBlock Text="{Binding NumThread, StringFormat=CPU threads: {0}}" Style="{StaticResource FieldLabel}"/>
                  <Slider Minimum="0" Maximum="32" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding NumThread}" Style="{StaticResource KuramaSlider}"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,12,14">
                  <TextBlock Text="{Binding MaxTokens, StringFormat=Max tokens / step: {0}}" Style="{StaticResource FieldLabel}"/>
                  <Slider Minimum="128" Maximum="2048" TickFrequency="64" IsSnapToTickEnabled="True" Value="{Binding MaxTokens}" Style="{StaticResource KuramaSlider}"/>
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="1" Margin="12,0,0,14">
                  <TextBlock Text="{Binding TimeoutSec, StringFormat=Timeout (sec): {0}}" Style="{StaticResource FieldLabel}"/>
                  <Slider Minimum="60" Maximum="600" TickFrequency="30" IsSnapToTickEnabled="True" Value="{Binding TimeoutSec}" Style="{StaticResource KuramaSlider}"/>
                </StackPanel>

                <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,12,0">
                  <TextBlock Text="Keep-alive" Style="{StaticResource FieldLabel}"/>
                  <ComboBox Style="{StaticResource KuramaCombo}" SelectedValue="{Binding KeepAlive}" SelectedValuePath="Content">
                    <ComboBoxItem Content="0"/>
                    <ComboBoxItem Content="5m"/>
                    <ComboBoxItem Content="10m"/>
                    <ComboBoxItem Content="15m"/>
                    <ComboBoxItem Content="30m"/>
                    <ComboBoxItem Content="-1"/>
                  </ComboBox>
                </StackPanel>
                <StackPanel Grid.Row="3" Grid.Column="1" Margin="12,0,0,0">
                  <TextBlock Text="{Binding Temperature, StringFormat=Temperature: {0:0.00}}" Style="{StaticResource FieldLabel}"/>
                  <Slider Minimum="0" Maximum="1.5" TickFrequency="0.05" IsSnapToTickEnabled="True" Value="{Binding Temperature}" Style="{StaticResource KuramaSlider}"/>
                </StackPanel>
              </Grid>

              <Button Content="Auto-allocate for this PC" Style="{StaticResource PrimaryButton}"
                      Command="{Binding AutoAllocateResourcesCommand}" Margin="0,18,0,0" HorizontalAlignment="Left"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <!-- SETTINGS -->
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <ScrollViewer.Style>
          <Style TargetType="ScrollViewer">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
              <DataTrigger Binding="{Binding SelectedPage}" Value="Settings"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
            </Style.Triggers>
          </Style>
        </ScrollViewer.Style>
        <StackPanel>
          <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
            <StackPanel>
              <TextBlock Style="{StaticResource SectionTitle}" Text="Loop &amp; safety toggles"/>
              <CheckBox Content="Require skill tests before use" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding SkillTestRequired}" Tag="Drafts must pass TESTS before promotion" Margin="0,8,0,10"/>
              <CheckBox Content="Require &lt;think&gt; block" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding RequireThinkBlock}" Tag="Model must emit a think block each turn" Margin="0,0,0,10"/>
              <CheckBox Content="Think block must cite sources" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ThinkMustCite}" Tag="Claims labeled observed / inferred / speculative" Margin="0,0,0,10"/>
              <CheckBox Content="Code runner network" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding CodeRunnerNetwork}" Tag="Off by default — constitution prefers no network in sandbox" Margin="0,0,0,10"/>
              <CheckBox Content="Log raw transcripts" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding LogRawTranscripts}" Tag="Verbose; usually leave off" Margin="0,0,0,10"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource CardStyle}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,10,0">
                <TextBlock Text="{Binding MaxSteps, StringFormat=Max steps: {0}}" Style="{StaticResource FieldLabel}"/>
                <Slider Minimum="1" Maximum="100" Value="{Binding MaxSteps}" Style="{StaticResource KuramaSlider}"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Margin="10,0">
                <TextBlock Text="{Binding ToolTopK, StringFormat=Tool top-k: {0}}" Style="{StaticResource FieldLabel}"/>
                <Slider Minimum="1" Maximum="20" Value="{Binding ToolTopK}" Style="{StaticResource KuramaSlider}"/>
              </StackPanel>
              <StackPanel Grid.Column="2" Margin="10,0,0,0">
                <TextBlock Text="{Binding MemoryTopK, StringFormat=Memory top-k: {0}}" Style="{StaticResource FieldLabel}"/>
                <Slider Minimum="1" Maximum="20" Value="{Binding MemoryTopK}" Style="{StaticResource KuramaSlider}"/>
              </StackPanel>
            </Grid>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <!-- APPEARANCE -->
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <ScrollViewer.Style>
          <Style TargetType="ScrollViewer">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
              <DataTrigger Binding="{Binding SelectedPage}" Value="Appearance"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
            </Style.Triggers>
          </Style>
        </ScrollViewer.Style>
        <StackPanel>
          <Border Style="{StaticResource CardStyle}">
            <StackPanel>
              <TextBlock Style="{StaticResource SectionTitle}" Text="Studio chrome"/>
              <CheckBox Content="Chat persona mode" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding PersonaMode}"
                        Tag="Kurama stays warm and conversational in chat; disciplined on goals" Margin="0,8,0,12"/>
              <CheckBox Content="Compact density" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding CompactMode}"
                        Tag="Tighter spacing for smaller screens" Margin="0,0,0,12"/>
              <TextBlock Text="{Binding UiScale, StringFormat=UI scale: {0:0.00}}" Style="{StaticResource FieldLabel}"/>
              <Slider Minimum="0.85" Maximum="1.25" TickFrequency="0.05" IsSnapToTickEnabled="True" Value="{Binding UiScale}" Style="{StaticResource KuramaSlider}"/>
              <TextBlock Text="Accent (hex)" Style="{StaticResource FieldLabel}" Margin="0,14,0,6"/>
              <TextBox Style="{StaticResource KuramaTextBox}" Text="{Binding AccentHex, UpdateSourceTrigger=PropertyChanged}" Width="160" HorizontalAlignment="Left"/>
              <TextBlock Text="Foxfire amber by default — Kurama's signature." Foreground="{StaticResource BrushTextMuted}" Margin="0,10,0,0" FontSize="12"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <!-- Toast -->
    <Border Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Bottom"
            Margin="0,0,24,24" Padding="14,10" CornerRadius="10"
            Background="{StaticResource BrushBgElevated}" BorderBrush="{StaticResource BrushAccent}" BorderThickness="1"
            Visibility="{Binding ShowToast, Converter={StaticResource BoolToVis}}">
      <TextBlock Text="{Binding Toast}" Foreground="{StaticResource BrushTextPrimary}" FontSize="12.5"/>
    </Border>
  </Grid>
</Window>
